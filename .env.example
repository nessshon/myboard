# Public address of this instance.
MYBOARD_PUBLIC_URL=https://example.com

# Owner's Telegram id, always admin.
MYBOARD_ADMIN_TG_ID=123456789

# @BotFather > your bot > Login Widget.
MYBOARD_TG_CLIENT_ID=0000000000
MYBOARD_TG_CLIENT_SECRET=change-me

# Optional. Same bot's token, enables notifications.
# MYBOARD_TG_BOT_TOKEN=

# Optional. Reverse proxy addresses allowed to send X-Real-IP.
# MYBOARD_TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Compose only. Host address and port, data volume or folder.
# MYBOARD_HOST=127.0.0.1
# MYBOARD_PORT=8090
# MYBOARD_DATA=myboard-data
